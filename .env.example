###############################################################################
# Stratum — Environment Configuration
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Quick secret generation (run once per environment):
#   make generate-secret   → SECRET_KEY + JWT_SECRET
#   make generate-fernet   → ENCRYPTION_KEY
###############################################################################


# ── Platform Security ─────────────────────────────────────────────────────────

# Random hex string used for general cryptographic signing (sessions, CSRF, etc.)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Or:       openssl rand -hex 32
SECRET_KEY=change-me-generate-with-scripts/generate-secret.sh

# Fernet symmetric key used to encrypt PostgreSQL credentials stored in the DB.
# This MUST be a valid Fernet key (base64-encoded 32-byte AES key).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or:       make generate-fernet
# WARNING:  Changing this key renders all stored connection credentials unreadable.
ENCRYPTION_KEY=change-me-32-bytes-fernet-key


# ── Database (Internal — Stratum platform data only) ─────────────────────────

# asyncpg-compatible PostgreSQL DSN for the internal Stratum database.
# In Docker Compose this points to the postgres service (host=postgres).
# In production replace with your managed PostgreSQL URL.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://stratum:stratum@postgres:5432/stratum


# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis URL used by Celery (broker + backend) and Redis pub/sub for WebSocket routing.
# In Docker Compose points to the redis service.
# Format: redis://[:<password>@]<host>:<port>/<db-number>
REDIS_URL=redis://redis:6379/0


# ── JWT Authentication ────────────────────────────────────────────────────────

# Secret key for signing JWT access tokens (HMAC-SHA256).
# Must be long and random — never reuse the same value across environments.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Or:       openssl rand -hex 32
JWT_SECRET=change-me

# Hashing algorithm for JWTs. HS256 is the recommended default.
# Only change if your organisation mandates RS256 (requires key pair).
JWT_ALGORITHM=HS256

# Access token lifetime in minutes. Default 10080 = 7 days.
# For production, reduce to 15 (short-lived) and rely on the refresh cookie.
JWT_EXPIRE_MINUTES=10080


# ── Application URLs ──────────────────────────────────────────────────────────

# Public URL of the Nuxt frontend — used in CORS allowed-origins.
FRONTEND_URL=http://localhost:3000

# Internal URL of the FastAPI backend — used by the frontend proxy.
BACKEND_URL=http://localhost:8000

# Runtime environment label. Values: development | staging | production
# Affects log verbosity, Sentry sample rates, and debug middleware.
ENVIRONMENT=development


# ── Query Execution Limits ────────────────────────────────────────────────────

# Hard wall-clock timeout (seconds) before a query worker is killed.
MAX_QUERY_RUNTIME_SECONDS=60

# Maximum rows fetched per query before truncation.
MAX_RESULT_ROWS=1000

# Rows streamed per WebSocket batch (affects client memory usage).
MAX_ROWS_PER_PAGE=100

# Row count above which undo snapshots are NOT captured (protects memory).
# Queries affecting more rows than this cannot be undone.
UNDO_MAX_ROWS_THRESHOLD=100000


# ── Connection Token Sharing ──────────────────────────────────────────────────

# TTL (minutes) for encrypted connection share tokens (used in team sharing).
CONNECTION_TOKEN_EXPIRE_MINUTES=30


# ── Observability (optional) ──────────────────────────────────────────────────

# Sentry DSN for error tracking and performance monitoring.
# Leave blank to disable. Get from: https://sentry.io → Project → Settings → DSN
# Format: https://<key>@<org>.ingest.sentry.io/<project-id>
SENTRY_DSN=
